---
import profile from "../data/profile.json";
import "../styles/global.css";
import "@fontsource-variable/manrope";
import "@fontsource-variable/dm-sans";
const title = `${profile.name} — Software Developer`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={profile.summary} />
    <link rel="canonical" href={profile.website} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={profile.summary} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={profile.website} />
    <meta name="theme-color" content="#f4f2ec" />
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <header class="nav wrap">
      <a href="#" class="brand" aria-label="Mustapha Annouaoui, home">
        ma<span>.</span>
      </a>
      <nav aria-label="Main navigation">
        <a href="#work">Work</a>
        <a href="#about">About</a>
        <a href="#contact">
          Contact <span aria-hidden="true">↗</span>
        </a>
      </nav>
    </header>
    <main id="main">
      <section class="hero wrap" aria-labelledby="intro">
        <div class="eyebrow">
          <span class="dot"></span> SOFTWARE DEVELOPER{" "}
          <span class="hero-location">/ {profile.location}</span>
        </div>
        <h1 id="intro">
          Behind the API.
          <br />
          <span>Beyond the screen.</span>
        </h1>
        <div class="hero-bottom">
          <div>
            <p class="intro-name">I'm Mustapha Annouaoui.</p>
            <p class="intro-text">
              I build backend services and mobile apps — from payment workflows
              in <strong>NestJS</strong> to everyday experiences in{" "}
              <strong>Flutter</strong>.
            </p>
            <div class="actions">
              <a class="button primary" href="#work">
                Explore my work <span aria-hidden="true">↓</span>
              </a>
              <a
                class="button outline"
                href="/Mustapha_Annouaoui_CV.pdf"
                download
              >
                Download CV <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
          <aside class="hero-note">
            <span class="mono">CURRENTLY AT</span>
            <a href="https://ora.ma/">
              Ora Technologies <span aria-hidden="true">↗</span>
            </a>
            <p>
              Payment services.
              <br />
              Mobile experiences.
              <br />
              The systems that connect them.
            </p>
          </aside>
        </div>
        <div class="stack-strip">
          <span class="mono">MY TOOLKIT</span>
          <span>TypeScript</span>
          <span>NestJS</span>
          <span>PostgreSQL</span>
          <span>Flutter</span>
          <span>Rust</span>
          <span>Docker</span>
        </div>
      </section>
      <section
        class="experience wrap"
        id="work"
        aria-labelledby="experience-title"
      >
        <div class="section-heading">
          <span class="mono">01 / PROFESSIONAL WORK</span>
          <h2 id="experience-title">
            From services
            <br />
            to the hands of users.
          </h2>
        </div>
        <div class="job-meta">
          <a href="https://ora.ma/">
            {profile.company} <span aria-hidden="true">↗</span>
          </a>
          <span>{profile.jobTitle}</span>
          <span>{profile.dates}</span>
        </div>
        <div class="product-grid">
          <article class="product cash">
            <div class="product-top">
              <span class="mono">BACKEND DEVELOPMENT</span>
            </div>
            <h3>Ora Cash</h3>
            <p>
              Backend services for a payment application and the tools its
              operations team uses.
            </p>
            <ul>
              <li>Authentication & role-based access</li>
              <li>Wallet & transaction management</li>
              <li>Audit logs, dashboards & exports</li>
            </ul>
            <div class="tags">
              <span>NestJS</span>
              <span>PostgreSQL</span>
              <span>Kafka</span>
            </div>
          </article>
          <article class="product kooul">
            <div class="product-top">
              <span class="mono">MOBILE DEVELOPMENT</span>
            </div>
            <h3>Kooul</h3>
            <p>
              A Flutter app that takes an order from product discovery through
              checkout to delivery tracking.
            </p>
            <ul>
              <li>Authentication, browsing & checkout</li>
              <li>Order management & real-time tracking</li>
              <li>Notifications, maps & analytics</li>
            </ul>
            <div class="tags">
              <span>Flutter</span>
              <span>Dart</span>
              <span>iOS & Android</span>
            </div>
          </article>
        </div>
      </section>
      <section class="projects wrap" aria-labelledby="projects-title">
        <div class="section-heading horizontal">
          <div>
            <span class="mono">02 / SELECTED PROJECTS</span>
            <h2 id="projects-title">Built to understand.</h2>
          </div>
          <a class="text-link" href={profile.github}>
            View GitHub <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="project-list">
          {profile.projects.map((project, i) => (
            <article class="project-row">
              <div
                class:list={["project-art", project.kind]}
                aria-hidden="true"
              >
                {project.kind === "pong" ? (
                  <div class="pong-court">
                    <i class="paddle one"></i>
                    <i class="paddle two"></i>
                    <i class="ball"></i>
                    <span>03 : 02</span>
                  </div>
                ) : project.kind === "server" ? (
                  <div class="server-art">
                    <span>GET / HTTP/1.1</span>
                    <b>
                      200 OK<span>_</span>
                    </b>
                    <small>connection: keep-alive</small>
                  </div>
                ) : (
                  <div class="rust-art">
                    <span>docker compose up</span>
                    <b>
                      Four services.
                      <br />
                      One environment.
                    </b>
                  </div>
                )}
              </div>
              <div class="project-copy">
                <span class="mono">
                  0{i + 1} / {project.type}
                </span>
                <h3>
                  <a href={project.url}>
                    {project.name} <span aria-hidden="true">↗</span>
                  </a>
                </h3>
                <p class="project-summary">{project.summary}</p>
                <p>{project.detail}</p>
                <div class="tags">
                  {project.tags.map((tag) => (
                    <span>{tag}</span>
                  ))}
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>
      <section class="about" id="about">
        <div class="wrap about-grid">
          <div>
            <span class="mono">03 / ABOUT ME</span>
            <h2>
              A foundation in systems.
              <br />
              <span>A focus on useful software.</span>
            </h2>
            <p>
              I studied computer science at <strong>1337 Coding School</strong>,
              where projects took me from C and C++ to networking and backend
              development.
            </p>
            <p>
              At Ora Technologies, I work across backend and mobile development.
              I enjoy understanding how the pieces fit together: the API, the
              database, and the experience on the other side of the screen.
            </p>
            <div class="education">
              <span class="mono">EDUCATION</span>
              <strong>1337 Coding School · Computer Science</strong>
              <span>Jan 2021 – Jan 2025 · Ben Guerir, Morocco</span>
            </div>
            <div class="languages">
              <span>
                Arabic <b>Native</b>
              </span>
              <span>
                English <b>Business level</b>
              </span>
            </div>
          </div>
          <div class="skills">
            {Object.entries(profile.skills).map(([group, items]) => (
              <div>
                <h3>{group}</h3>
                <p>{items.join(" · ")}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
      <section class="contact wrap" id="contact">
        <span class="mono">04 / GET IN TOUCH</span>
        <h2>
          Have something
          <br />
          <span>worth building?</span>
        </h2>
        <a class="email" href={`mailto:${profile.email}`}>
          {profile.email} <span aria-hidden="true">↗</span>
        </a>
        <div class="contact-bottom">
          <p>
            {profile.location}
            <br />
            Arabic & English
          </p>
          <div>
            <a href={profile.linkedin}>LinkedIn ↗</a>
            <a href={profile.github}>GitHub ↗</a>
            <a href="/Mustapha_Annouaoui_CV.pdf" download>
              CV ↓
            </a>
          </div>
        </div>
      </section>
    </main>
    <footer class="wrap">
      <span>
        © {new Date().getFullYear()} {profile.name}
      </span>
      <a href="#">Back to top ↑</a>
    </footer>
  </body>
</html>
